{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wasdwry-diary-auth",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://wasdwry-diary-auth.YOUR-SUBDOMAIN.workers.dev",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_GITHUB_APP_CLIENT_ID",
    "GITHUB_INSTALLATION_ID": "REPLACE_WITH_INSTALLATION_ID"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "wasdwry-diary-sessions", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "triggers": { "crons": ["17 3 * * *"] }
}
